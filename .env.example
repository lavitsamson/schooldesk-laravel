APP_NAME=SchoolDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail defaults. PostgreSQL is also supported: DB_CONNECTION=pgsql, DB_PORT=5432.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=schooldesk
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Student import: rows per queued chunk, max upload size, days before batches and error reports are pruned
IMPORT_CHUNK_SIZE=200
IMPORT_MAX_FILE_KB=5120
IMPORT_KEEP_DAYS=30

# Attendance: minutes an absence mail to the primary guardian waits (a quick correction cancels it)
ABSENCE_NOTIFICATION_DELAY_MINUTES=10

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@schooldesk.test"
MAIL_FROM_NAME="${APP_NAME}"

# Sail
APP_PORT=80
FORWARD_DB_PORT=3306
WWWUSER=1000
WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"

# SchoolDesk
INVITATION_EXPIRE_DAYS=7

# AI report-card comment drafts (off per school until an admin turns them on).
# Without ANTHROPIC_API_KEY a built-in fake writes the drafts and nothing leaves the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true
ANTHROPIC_TIMEOUT=30
AI_DRAFTS_PER_HOUR=100

# Fees. Invoices for a term are generated this many days before it starts.
FEES_GENERATE_DAYS_AHEAD=14
FEES_INVOICE_PREFIX=SD

# Stripe (test mode keys only). Without STRIPE_SECRET, parents cannot pay online and admins
# record cash and bank payments. STRIPE_WEBHOOK_SECRET is printed by
# `stripe listen --forward-to localhost/webhooks/stripe`.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
